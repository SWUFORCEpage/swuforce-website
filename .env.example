# Set these ONLY in Render Web Service > Environment. Never prefix secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# To open anonymous posting, configure Cloudflare Turnstile in production.
# Both keys must be supplied together. Optional during local setup.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# PORT is set by Render. Locally, server defaults to 10000.
